<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grid_bg_base">

    <!-- Topbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grid Operator"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/roleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Role: Grid Operator"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grid operational"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grid_border" />

    <!-- Telemetry Ticker -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FREQ"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/kpiFrequencyValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50.02 Hz"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAD"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/kpiLoadValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,842 kW"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEN"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/kpiGenValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,310 kW"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESERVE"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/kpiReserveValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="38%"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/accent_cyan" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grid_border" />

    <!-- Simple Dashboard Center Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Grid Management"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_grid"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned Microgrids Operational"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Monitor microgrid telemetry, verify transaction QR codes, and review prosumer reservation approvals."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Prominent Check Reservations Action Button -->
            <Button
                android:id="@+id/checkReservationsButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_amber"
                android:text="📋 Check Reservations"
                android:textAllCaps="false"
                android:textColor="@color/bg_base"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/grid_border" />

    <!-- Navigation Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/grid_surface"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/scanVerifyButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_outline_cyan"
            android:text="Scan &amp; Verify QR"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />

        <Button
            android:id="@+id/microgridNodesButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline_cyan"
            android:text="Microgrid nodes"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />

        <Button
            android:id="@+id/nearbyNodesButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent_cyan"
            android:text="Nearby nodes (map)"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline_cyan"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>