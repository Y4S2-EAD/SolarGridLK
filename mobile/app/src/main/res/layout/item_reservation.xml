<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Node ID & Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nodeIdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NODE-001"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Status Pill Drawable Mapping:
             - Pending   -> bg_pill_pending
             - Approved  -> bg_pill_watch
             - Completed -> bg_pill_settled
             - Cancelled -> bg_pill_flagged
        -->
        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_pending"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="PENDING"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Slot Date & Time -->
    <TextView
        android:id="@+id/slotTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Slot: 2026-09-27 14:00"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Booked / Created On Date -->
    <TextView
        android:id="@+id/createdAtText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Booked on: 2026-09-29 16:21"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Action Buttons Row: View QR, Modify, Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/qrButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:text="View QR"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/modifyButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:text="Modify"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/cancelButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:text="Cancel"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>