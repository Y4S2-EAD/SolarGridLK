<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_grid"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Node ID & Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nodeIdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NODE-001"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pending"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="PENDING"
            android:textColor="#F4A93B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Prosumer NIC -->
    <TextView
        android:id="@+id/prosumerNicText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Prosumer: 200012345678"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Slot Date & Time -->
    <TextView
        android:id="@+id/slotTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Slot: 2026-10-01 10:00"
        android:textColor="@color/accent_cyan"
        android:textSize="13sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/approveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_amber"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="✓ Approve Reservation"
            android:textAllCaps="false"
            android:textColor="@color/bg_base"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>